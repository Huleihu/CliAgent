build/
dist/
*.egg-info/
htmlcov/
.coverage
coverage.xml

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
.tmp/
.pytest-tmp/
pytest-cache-files-*/

# Local runtime state
var/
sandbox/
